{
  "name": "cropperjs-react-wrapper",
  "version": "1.2.0",
  "description": "A modern, lightweight React wrapper for Cropper.js v2 with TypeScript support",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trigger-xyz/cropperjs-react-wrapper.git"
  },
  "keywords": [
    "react",
    "cropperjs",
    "cropper",
    "image-cropper",
    "image-editor",
    "web-components"
  ],
  "author": "Trigger",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.18.0",
  "workspaces": [
    "example/*"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "dev": "npm run dev:vite",
    "dev:vite": "vite -c vite.demo.config.ts",
    "dev:nextjs": "npm run build && npm run dev --workspace @cropperjs-react-wrapper/example-nextjs",
    "build": "vite build && rollup -c rollup.dts.config.mjs && npm run test:build-output",
    "build:examples": "npm run build && turbo run build --filter='./example/*'",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest",
    "test:all": "vitest run && npm test --workspaces --if-present",
    "test:build-output": "node scripts/assert-build-output.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rollup": "^4.62.5",
    "rollup-plugin-dts": "^6.5.1",
    "turbo": "^2.10.11",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "cropperjs": "^2.2.0"
  }
}
