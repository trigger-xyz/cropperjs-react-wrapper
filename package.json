{
  "name": "cropperjs-react-wrapper",
  "version": "1.3.0",
  "description": "A modern, lightweight React wrapper for Cropper.js v2 with TypeScript support",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trigger-xyz/cropperjs-react-wrapper.git"
  },
  "keywords": [
    "react",
    "cropperjs",
    "cropper",
    "image-cropper",
    "image-editor",
    "web-components"
  ],
  "author": "Trigger",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@12.2.1",
  "workspaces": [
    "example/*"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "node .husky/install.mjs",
    "prepublishOnly": "npm run build",
    "dev": "npm run dev:vite",
    "dev:vite": "vite -c vite.demo.config.ts",
    "dev:nextjs": "npm run build && npm run dev --workspace @cropperjs-react-wrapper/example-nextjs",
    "build": "vite build && rollup -c rollup.dts.config.mjs && npm run test:build-output",
    "build:examples": "npm run build && turbo run build --filter='./example/*'",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:staged": "lint-staged",
    "test": "vitest",
    "test:all": "vitest run && npm test --workspaces --if-present",
    "test:browser": "playwright test",
    "test:browser:firefox": "playwright test --config=playwright.firefox.config.ts",
    "test:build-output": "node scripts/assert-build-output.mjs",
    "test:compatibility": "npm run build && node tests/compatibility/run.ts",
    "verify": "npm run lint && npm run test:all && npm run build:examples && npm run typecheck && npm run test:compatibility && npm run test:browser && npm run test:browser:firefox",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rollup": "^4.67.4",
    "rollup-plugin-dts": "^6.5.1",
    "turbo": "^2.11.10",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "cropperjs": "^2.3.1"
  },
  "allowScripts": {
    "fsevents": false
  },
  "lint-staged": {
    "*": "biome check --no-errors-on-unmatched --files-ignore-unknown=true"
  }
}
