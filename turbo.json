{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "src/**",
    "dist/**",
    "vite*.config.ts",
    "tsconfig*.json",
    "example/vite/assets/**"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {
      "outputs": []
    }
  }
}
